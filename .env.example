# LLM API（OpenAI 兼容格式）
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# 备选：更快更便宜（JSON+thinking 偶发空 content）
# LLM_MODEL=deepseek-v4-flash
# 旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役

# Tushare Pro（https://tushare.pro）
TUSHARE_TOKEN=your_tushare_token_here

# Cursor Agent SDK（Dashboard → API Keys；用于每5天周期自优化）
CURSOR_API_KEY=your_cursor_api_key_here

# 邮件通知（默认只发分析报告；自优化报告需在 config.yaml 设 email.send_optimize=true）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465，密码填「授权码」不是登录密码
# 163：smtp.163.com:465；Gmail：smtp.gmail.com:587（需应用专用密码）
EMAIL_ENABLED=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_name@qq.com
SMTP_PASSWORD=your_smtp_auth_code
EMAIL_FROM=your_name@qq.com
# 多个收件人用逗号或分号分隔；每人首次收到系统邮件时会附带 docs/how-to-read-report.md（只发一次）
EMAIL_TO=your_name@qq.com, another@example.com

# 可选：Anthropic Claude（多 Agent 副分析师）
# ANTHROPIC_API_KEY=your_anthropic_key
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_BASE_URL=   # 若走 OpenAI 兼容网关再填
