# 复制为 config.yaml 后修改
#
# 关键语义（新手必读）：
# - holdings = 你声明的真实持仓；未声明或 [] = 空仓
# - screen = 个股遴选漏斗（默认全 A 现货 → 量化 → 深度分析）；深度池全部自动筛选
# - 若有 holdings，持仓代码会强制进深度池（不占 max_deep）

# 关注板块（详细论证 B1 LLM 叙事；另可从资金流自动扩 auto_sector_from_flow 只）
watch_sectors:
  - 半导体
  - 新能源
  - 白酒
  - 银行

# 个股遴选：全 A / 板块成分 → 量化初筛 → 深度分析（LLM）；中长线偏估值+主题分散
screen:
  enabled: true
  universe_mode: spot_all      # spot_all=全 A 现货（推荐）；sector_spot=仅关注板块成分（窄池教学）
  max_universe: 400
  max_quant: 50                # 量化入围
  max_deep: 15                 # 量化新票上限；声明持仓强制进池时不占此名额
  sector_cons_limit: 60
  min_amount: 50000000         # 成交额下限（元）
  pe_max: 0                    # <=0 不硬截断高 PE；打分会降权
  exclude_negative_pe: false   # 亏损扩张期票默认可进池
  exclude_st: true
  sector_priority_boost: 5     # 主题加分（中长线略降，避免科技链独占）
  auto_sector_from_flow: 3     # 资金流入前列自动扩 B1 板块（0=关闭）
  deep_diversify: true         # 深度池按粗主题分散（不改量化排序，只约束细读名单）
  max_deep_per_theme: 5        # 同一粗主题（如科技硬件）最多几只新票
  deep_theme_floor: 1          # 关注/优先中的防御板块（银行/白酒等）软保底席位
  deep_relax_theme_cap: false  # false=同主题已满宁缺毋滥（中长线推荐）
  exclude_surge_main_pct: 7.0      # 主板暴涨当日剔除新票；0=关闭
  exclude_surge_chi_star_pct: 14.0 # 创业板/科创；约 70%×涨跌停
  # exclude_surge_pct: 7.0         # 若设置则两板共用（不推荐）
  amount_avg_days: 20              # 成交额用近 N 日均（0=当日）；P1 中长线

# 行情通路（第四波深治）
data:
  eastmoney_force_direct: true     # 调东财时绕过系统代理
  eastmoney_bypass: both           # env_clear | session_trust_env_false | both | off

# 微观结构门禁（机制压力；非短线择时）
microstructure:
  severe_forbid_new_buys: true
  mild_confirm_rounds: 1       # 轻/中度需上轮已压力才禁新买
  extreme_limit_ratio: 50.0    # 涨停/跌停比达此视为极端拥挤

# 中长线框架闸
framework_gates:
  prosperity_block_adds: true          # 景气 down 禁 buy/add
  contradiction_haircut: 0.8           # 矛盾激活时置信/仓位折扣
  contradiction_block_offensive: true  # 矛盾时禁进攻向开加仓
  policy_requires_hard_resonance: true # 政策须硬共振才买
  phase_upgrade_needs_confirm: true    # 升乐观要慢

# 持仓（空仓示例；有仓再填 code / quantity / cost）
# 跑任务时：未说明持仓 → 必须保持 []；说明了再写入
holdings: []

# 模拟组合：独立小报告 *-sim.md，评估「若完全按④终局执行」；与真实 holdings 分离
sim:
  enabled: true
  initial_cash: 50000
  lot_size: 100
  default_buy_pct: 10        # 仅作配置保留；报告缺 position_pct 时模拟盘不再静默开仓

# 交易约束（中长线：止损更宽、止盈更高）
trading:
  max_single_position_pct: 20
  max_total_position_pct: 80   # 硬顶；股债 ERP 可再压低有效总仓
  stop_loss_pct: 15
  take_profit_pct: 40

# 经营现金流质量闸（利润为正但 OCF 持续为负 → 禁止新买）
quality:
  ocf_gate_enabled: true
  min_ocf_to_profit: 0.5
  require_periods: 2
  block_on_negative_ocf: true

# 股债相对价值 → A1 总仓上限（沪深300 盈利收益率 − 中国10Y）
equity_bond:
  enabled: true
  index_name: 沪深300
  index_code: "000300.SH"

# 复盘回看窗口（天）
review_lookback_days: 60

# 调度：每周二、周五本地 01:00 由 LaunchAgent/cron 触发（分析 + 可选邮件）
# 安装：./scripts/install_launchd.sh（macOS 推荐）或 ./scripts/install_cron.sh
schedule:
  cadence: tue_fri
  interval_days: 3            # 非 tue_fri 时的间隔门禁；tue_fri 以星期为准
  run_hour: 1

# 分析取向：中长线周期
analysis:
  prompt_version: v3-midlong-5d
  investment_horizon: medium_long
  default_time_horizon: medium
  review_min_hold_days: 14
  paper_horizon_days: 60
  debate_top_k: 3             # >0 开启：所有 buy/add 必辩；0=关闭

# 邮件通知（密钥放 .env）
email:
  enabled: false
  send_analysis: true

# 多 Agent 决策
agents:
  enabled: true
  decision_multi: true
  parallel: true
  primary_provider: deepseek
  # 默认同模型异 prompt；Cursor secondary 见 docs/TODO_optimizations.md
  secondary_provider: deepseek
  secondary_model: ""  # 空则跟 llm_model
  synthesizer_provider: deepseek
  cursor_model: composer-2.5
  llm_timeout_seconds: 300
  llm_max_retries: 2
  llm_max_tokens: 32768          # 亦可 LLM_MAX_TOKENS；决策大 JSON+thinking 勿过小
  cursor_timeout_seconds: 180
  cursor_max_retries: 2
  # 略大于 llm_timeout × (retries+1)，避免编排层先掐断
  agent_wait_seconds: 960

intelligence:
  enabled: true
  max_news_per_source: 8
  digest_before_analysis: true
  news_lookback_days: 14

tushare:
  enabled: true

rss:
  enabled: true
  cls_direct: true
  use_fallback_rss: false          # 无自建前保持关；推荐：早餐→CLS→自建 RSSHub
  cls_timeout_sec: 8
  rsshub_base: ""                  # 例 https://rsshub.example.com（fallback 开时生效）
  max_items_per_feed: 10
  feeds: []

sentiment:
  enabled: true
  role: crowding_only          # 拥挤调节器；非 alpha 加分
  mainline_pool_only: true     # 综合舆情只打政策/宏观主线池

trend:
  enabled: true

paths:
  db: data/money_more.db
  reports: reports
